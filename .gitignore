*.mp3
*.mp4
*.m4a
*.wav
*.ogg
*.flac
*.webm
*.mpeg
*.mpga

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs
*.log
publish-log.json
