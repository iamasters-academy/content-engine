# content-engine — environment variables
# Copy this file to .env.local and fill in your real keys.
# .env.local is git-ignored. NEVER commit real keys.

# Fal.ai — image generation (nano-banana-2)
# Get yours at: https://fal.ai/dashboard/keys
FAL_KEY=your-fal-key-here

# Groq — audio transcription (whisper-large-v3-turbo)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here

# Upload-Post — publishing to LinkedIn / Instagram / X
# Get yours at: https://upload-post.com (Free tier: 10 uploads/month)
UPLOAD_POST_API_KEY=your-upload-post-key-here
