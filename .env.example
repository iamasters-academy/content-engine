# content-engine — variables de entorno
# Copia este archivo a .env.local y rellena tus claves reales.
# .env.local está gitignored. NUNCA hagas commit de claves reales.

# Fal.ai — generación de imagen (default: nano-banana-2 de Google)
# Consigue tu key en: https://fal.ai/dashboard/keys
FAL_KEY=tu-fal-key-aqui

# Groq — transcripción de audio/vídeo (whisper-large-v3-turbo)
# Solo obligatoria si vas a pasar audios o vídeos como input.
# Consigue tu key en: https://console.groq.com/keys
GROQ_API_KEY=tu-groq-key-aqui

# Upload-Post — publicación en LinkedIn / Instagram / X
# Solo obligatoria si vas a publicar (puedes usar la skill solo para generar).
# Consigue tu key en: https://upload-post.com (Free: 10 publicaciones/mes)
UPLOAD_POST_API_KEY=tu-upload-post-key-aqui

# OpenAI — alternativa de imagen (gpt-image-1 / DALL-E 3 actualizado)
# Solo necesaria si elegiste OpenAI como proveedor en image_config.yaml.
# Consigue tu key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=tu-openai-key-aqui
